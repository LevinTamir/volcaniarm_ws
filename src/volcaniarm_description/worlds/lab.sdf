<sdf version="1.6">
  <world name="lab">
    <physics name="fast" type="dart">
      <max_step_size>0.005</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <dart>
        <solver>
          <solver_type>pgs</solver_type>
        </solver>
        <collision_detector>ode</collision_detector>
      </dart>
    </physics>
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-contact-system"
      name="gz::sim::systems::Contact">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <gravity>0 0 -9.8</gravity>
    <atmosphere type="adiabatic"/>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.8 1.0 1</background>
      <grid>false</grid>
    </scene>

    <!-- ==================================================================
         Lab decor mirroring the Isaac Sim lab overlay
         (volcaniarm_isaaclab/scripts/build_lab.py). Same colors, same
         dimensions, same weed asset, so the two sims share a visual
         reference:
           floor  concrete grey  (0.72 0.70 0.68)
           walls  off-white      (0.92 0.91 0.88), open front / no ceiling
           mat    matte black rubber, 0.9 x 2.0 x 0.006 m centred on robot
           weed   3D-printed fake_weed STL, 0.115 m tall, on the mat
         ================================================================== -->

    <!-- Concrete floor under the robot -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>8 8</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>50</mu>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>8 8</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.72 0.70 0.68 1</ambient>
            <diffuse>0.72 0.70 0.68 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Black non-reflective rubber mat under the rig. Visual-only (no
         collision), same as the Isaac overlay — the robot's wheels rest
         on the ground plane, the 6 mm mat is cosmetic. -->
    <model name="floor_mat">
      <static>true</static>
      <pose>0 0 0.003 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.9 2.0 0.006</size>
            </box>
          </geometry>
          <material>
            <ambient>0.04 0.04 0.04 1</ambient>
            <diffuse>0.04 0.04 0.04 1</diffuse>
            <specular>0.0 0.0 0.0 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Room shell: back wall 0.5 m behind the arm plus two side walls.
         Open-fronted and open-topped like the Isaac lab — the walls exist
         to give the camera a realistic background, not to seal a volume.
         NOTE: the Gazebo robot faces -X (mirrored vs the Isaac stage, where
         the converted USD faces +X), so the whole room is rotated 180°
         relative to build_lab.py: back wall on +X, interior x in
         [-3.0, 0.5], y in [-2.0, 2.0], height 2.6. -->
    <model name="room_shell">
      <static>true</static>
      <link name="link">
        <visual name="back_wall">
          <pose>0.55 0 1.3 0 0 0</pose>
          <geometry>
            <box>
              <size>0.1 4.2 2.6</size>
            </box>
          </geometry>
          <material>
            <ambient>0.92 0.91 0.88 1</ambient>
            <diffuse>0.92 0.91 0.88 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
        <visual name="left_wall">
          <pose>-1.25 2.05 1.3 0 0 0</pose>
          <geometry>
            <box>
              <size>3.5 0.1 2.6</size>
            </box>
          </geometry>
          <material>
            <ambient>0.92 0.91 0.88 1</ambient>
            <diffuse>0.92 0.91 0.88 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
        <visual name="right_wall">
          <pose>-1.25 -2.05 1.3 0 0 0</pose>
          <geometry>
            <box>
              <size>3.5 0.1 2.6</size>
            </box>
          </geometry>
          <material>
            <ambient>0.92 0.91 0.88 1</ambient>
            <diffuse>0.92 0.91 0.88 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- The 3D-printed fake weed standing on the mat — the same STL the
         Isaac task trains against (volcaniarm_isaaclab assets/STLs/
         fake_weed.stl, authored in mm at 73.35 mm tall, bbox cornered at
         the origin). Scale 0.115/73.352 = 0.0015678 brings it to the
         0.115 m contract height; the visual pose offsets by half the
         scaled XY footprint so the model pose is where the weed stands.
         Pose is Isaac's WEED_XY (0.071, 0.10) rotated 180° with the room
         (Gazebo robot faces -X): 7.1 cm in front of the arm, 10 cm to its
         left, base on the mat top. -->
    <model name="weed_target">
      <static>true</static>
      <pose>-0.071 -0.10 0.006 0 0 0</pose>
      <link name="link">
        <visual name="weed_visual">
          <pose>-0.054327 -0.049507 0 0 0 0</pose>
          <geometry>
            <mesh>
              <uri>model://fake_weed/meshes/fake_weed.stl</uri>
              <scale>0.0015678 0.0015678 0.0015678</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.24 0.75 0.51 1</ambient>
            <diffuse>0.24 0.75 0.51 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
