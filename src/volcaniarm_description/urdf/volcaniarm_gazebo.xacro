<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="volcaniarm">

  <!-- ROS 2 Control (Jazzy - Gazebo) -->
  <!-- YAML(s) loaded depend on the `controller` xacro arg:
         traj          → trajectory YAML only
         policy        → state-based RL YAML only
         vision_policy → vision RL YAML only
         all           → trajectory + state-based RL (runtime switching) -->
  <xacro:property name="_ctrl" value="$(arg controller)" />
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <xacro:if value="${_ctrl == 'traj' or _ctrl == 'all'}">
        <parameters>$(find volcaniarm_controllers)/config/volcaniarm_controllers.yaml</parameters>
      </xacro:if>
      <xacro:if value="${_ctrl == 'policy' or _ctrl == 'all'}">
        <parameters>$(find volcaniarm_controllers)/config/volcaniarm_rl_controller.yaml</parameters>
      </xacro:if>
      <xacro:if value="${_ctrl == 'vision_policy'}">
        <parameters>$(find volcaniarm_controllers)/config/volcaniarm_rl_vision_controller.yaml</parameters>
      </xacro:if>
    </plugin>
  </gazebo>

  <!-- RGBD Camera sensor.
       Tuned to mimic the real D435 *color* stream that apriltag_ros
       consumes, while staying decodable for the 0.064 m tags and light
       enough for an acceptable Gazebo RTF:
         - HFOV 1.204 rad (~69 deg) = the real D435 color H-FoV. The old
           1.5 rad (~86 deg) matched the D435 *depth* FoV, not color. The
           16:9 image makes the derived V-FoV ~42 deg, also matching the
           color stream. Narrower FoV makes each tag larger in pixels at
           no render cost.
         - 1280x720 (native D435 mode): a 0.064 m tag is ~43 px at ~1.6 m
           (decodable; ~68 px at ~1.0 m). 720p is the practical floor for
           64 mm tags; 848x480 left them at ~28 px, below the 36h11 floor.
         - 10 Hz (was 15) + visualize off claws back the render load that
           720p adds; calibration sweeps and weed detection don't need a
           fast frame rate.
       The bridged camera_info follows this sensor, so apriltag picks up
       the intrinsics automatically. Note: at 69/42 deg and 1.6 m the full
       EE Z-envelope no longer fits one frame (the old 86 deg was a
       non-physical widening); that mirrors the real D435 and is handled
       by standoff/tilt on hardware. -->
  <gazebo reference="camera_link">
      <sensor name="rgbd_camera" type="rgbd_camera">
          <camera>
              <!-- RealSense D435i color-sensor geometry (the composed
                   pointcloud inherits COLOR intrinsics since depth is
                   aligned to color): HFOV 69° = 1.20428 rad; gz derives
                   VFOV from the image aspect, matching the D435i's 42°
                   spec at 16:9-ish. Clip mirrors the D435 usable depth
                   band (MinZ ~0.195 m, 10 m rated max). Same numbers as
                   the Isaac camera prim in
                   volcaniarm_isaaclab/scripts/add_ros2_graph.py.
                   (This branch renders 1280x720@10 for apriltag decode
                   range instead of main's 848x480@15.) -->
              <horizontal_fov>1.20428</horizontal_fov>
              <image>
                  <width>1280</width>
                  <height>720</height>
              </image>
              <clip>
                  <near>0.195</near>
                  <far>10</far>
              </clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>10</update_rate>
          <visualize>false</visualize>
          <topic>rgbd_camera</topic>
          <!-- All sensor outputs tagged with the OPTICAL frame, matching
               what the RealSense driver and Isaac's ROS2 bridge stamp on
               their images. This matters because /camera/depth/color/points
               is no longer Gazebo's native cloud — it is composed from the
               color + aligned-depth images by the shared depth_image_proc
               pipeline (camera_pointcloud.launch.py), which back-projects
               in the optical convention (Z forward, Y down) and inherits
               this frame_id. Tagged with camera_link the composed cloud
               renders tilted ~90° in RViz.
               (The old warning about optical_frame_id double-rotating the
               native pointcloud is obsolete: the native cloud isn't
               bridged anymore, and this uses gz_frame_id relabeling only.)
               AprilTag detections become children of the optical frame,
               same as on real hardware; the calibration runner only uses
               relative marker transforms, so it is unaffected. -->
          <gz_frame_id>camera_color_optical_frame</gz_frame_id>
      </sensor>
  </gazebo>

  <!-- DetachableJoint: closes the 5-bar loop at runtime -->
  <gazebo>
    <plugin filename="libgz-sim-detachable-joint-system.so"
            name="gz::sim::systems::DetachableJoint">
      <parent_link>right_arm_tip_link</parent_link>
      <child_model>volcaniarm</child_model>
      <child_link>closure_dummy_link</child_link>
    </plugin>
  </gazebo>

  <!-- Joint state publisher: broadcasts all joint positions back to ROS2 -->
  <gazebo>
    <plugin filename="libgz-sim-joint-state-publisher-system.so"
            name="gz::sim::systems::JointStatePublisher"/>
  </gazebo>

</robot>
