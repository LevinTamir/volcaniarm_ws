<?xml version="1.0"?>
<!-- Semantic description for MoveIt planning of the Volcaniarm five-bar.
     MoveIt plans the OPEN phantom chain (volcaniarm_base_link -> tool0 via the
     prismatic tool_joint_y/z); the joint_state_transformer node converts the
     planned tool pose into the real elbow angles (inverse_ee) for execution.
     The five real loop joints are passive (MoveIt never commands them). -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="volcaniarm">

  <!-- Planning group: the 2-DOF phantom chain positioning the EE point tool0. -->
  <group name="ee">
    <chain base_link="volcaniarm_base_link" tip_link="tool0"/>
  </group>

  <!-- Home = q=0 assembly. The phantom origins put tool0 on the home EE when both
       phantom joints are 0, so the default state is home and the goal marker
       starts exactly on the EE. -->
  <group_state name="home" group="ee">
    <joint name="tool_joint_y" value="0.0"/>
    <joint name="tool_joint_z" value="0.0"/>
  </group_state>

  <!-- The real linkage joints are driven by the loop closure / the transformer,
       never commanded directly by MoveIt. -->
  <passive_joint name="volcaniarm_left_elbow_joint"/>
  <passive_joint name="volcaniarm_right_elbow_joint"/>
  <passive_joint name="volcaniarm_left_arm_joint"/>
  <passive_joint name="volcaniarm_right_arm_joint"/>
  <passive_joint name="closure_joint"/>

  <!-- Disable the permanently-closed loop link pairs so the mechanism is not
       flagged as self-colliding during phantom planning. -->
  <disable_collisions link1="volcaniarm_base_link" link2="volcaniarm_left_elbow_link" reason="Adjacent"/>
  <disable_collisions link1="volcaniarm_base_link" link2="volcaniarm_right_elbow_link" reason="Adjacent"/>
  <disable_collisions link1="volcaniarm_left_elbow_link" link2="volcaniarm_left_arm_link" reason="Adjacent"/>
  <disable_collisions link1="volcaniarm_right_elbow_link" link2="volcaniarm_right_arm_link" reason="Adjacent"/>
  <disable_collisions link1="volcaniarm_left_arm_link" link2="closure_dummy_link" reason="Adjacent"/>
  <disable_collisions link1="volcaniarm_right_arm_link" link2="right_arm_tip_link" reason="Adjacent"/>
  <disable_collisions link1="closure_dummy_link" link2="right_arm_tip_link" reason="Closure"/>
  <disable_collisions link1="closure_dummy_link" link2="volcaniarm_right_arm_link" reason="Closure"/>
  <disable_collisions link1="right_arm_tip_link" link2="volcaniarm_left_arm_link" reason="Closure"/>
  <disable_collisions link1="volcaniarm_left_arm_link" link2="volcaniarm_right_arm_link" reason="Closure"/>
  <disable_collisions link1="volcaniarm_left_elbow_link" link2="volcaniarm_right_elbow_link" reason="Never"/>

  <!-- Rigid static structure (table, legs, casters, column, camera
       chain): all connected by fixed joints, so relative motion is
       impossible and any contact is by construction. Without these the
       planning-scene monitor flags the touching fixed pairs as self-
       colliding and MoveIt RViz paints them with Colliding Link Color
       (bright red) — which looks exactly like a stale color scheme. -->
  <disable_collisions link1="base_link" link2="fl_table_leg_link" reason="Never"/>
  <disable_collisions link1="base_link" link2="fr_table_leg_link" reason="Never"/>
  <disable_collisions link1="base_link" link2="rl_table_leg_link" reason="Never"/>
  <disable_collisions link1="base_link" link2="rr_table_leg_link" reason="Never"/>
  <disable_collisions link1="base_link" link2="fl_caster_wheel_mount_link" reason="Never"/>
  <disable_collisions link1="base_link" link2="fr_caster_wheel_mount_link" reason="Never"/>
  <disable_collisions link1="base_link" link2="rl_caster_wheel_mount_link" reason="Never"/>
  <disable_collisions link1="base_link" link2="rr_caster_wheel_mount_link" reason="Never"/>
  <disable_collisions link1="base_link" link2="fl_caster_wheel_link" reason="Never"/>
  <disable_collisions link1="base_link" link2="fr_caster_wheel_link" reason="Never"/>
  <disable_collisions link1="base_link" link2="rl_caster_wheel_link" reason="Never"/>
  <disable_collisions link1="base_link" link2="rr_caster_wheel_link" reason="Never"/>
  <disable_collisions link1="base_link" link2="volcaniarm_base_link" reason="Never"/>
  <disable_collisions link1="base_link" link2="camera_mount_linear_link" reason="Never"/>
  <disable_collisions link1="base_link" link2="camera_mount_rev_link" reason="Never"/>
  <disable_collisions link1="base_link" link2="camera_link" reason="Never"/>
  <disable_collisions link1="fl_table_leg_link" link2="fr_table_leg_link" reason="Never"/>
  <disable_collisions link1="fl_table_leg_link" link2="rl_table_leg_link" reason="Never"/>
  <disable_collisions link1="fl_table_leg_link" link2="rr_table_leg_link" reason="Never"/>
  <disable_collisions link1="fl_table_leg_link" link2="fl_caster_wheel_mount_link" reason="Never"/>
  <disable_collisions link1="fl_table_leg_link" link2="fr_caster_wheel_mount_link" reason="Never"/>
  <disable_collisions link1="fl_table_leg_link" link2="rl_caster_wheel_mount_link" reason="Never"/>
  <disable_collisions link1="fl_table_leg_link" link2="rr_caster_wheel_mount_link" reason="Never"/>
  <disable_collisions link1="fl_table_leg_link" link2="fl_caster_wheel_link" reason="Never"/>
  <disable_collisions link1="fl_table_leg_link" link2="fr_caster_wheel_link" reason="Never"/>
  <disable_collisions link1="fl_table_leg_link" link2="rl_caster_wheel_link" reason="Never"/>
  <disable_collisions link1="fl_table_leg_link" link2="rr_caster_wheel_link" reason="Never"/>
  <disable_collisions link1="fl_table_leg_link" link2="volcaniarm_base_link" reason="Never"/>
  <disable_collisions link1="fl_table_leg_link" link2="camera_mount_linear_link" reason="Never"/>
  <disable_collisions link1="fl_table_leg_link" link2="camera_mount_rev_link" reason="Never"/>
  <disable_collisions link1="fl_table_leg_link" link2="camera_link" reason="Never"/>
  <disable_collisions link1="fr_table_leg_link" link2="rl_table_leg_link" reason="Never"/>
  <disable_collisions link1="fr_table_leg_link" link2="rr_table_leg_link" reason="Never"/>
  <disable_collisions link1="fr_table_leg_link" link2="fl_caster_wheel_mount_link" reason="Never"/>
  <disable_collisions link1="fr_table_leg_link" link2="fr_caster_wheel_mount_link" reason="Never"/>
  <disable_collisions link1="fr_table_leg_link" link2="rl_caster_wheel_mount_link" reason="Never"/>
  <disable_collisions link1="fr_table_leg_link" link2="rr_caster_wheel_mount_link" reason="Never"/>
  <disable_collisions link1="fr_table_leg_link" link2="fl_caster_wheel_link" reason="Never"/>
  <disable_collisions link1="fr_table_leg_link" link2="fr_caster_wheel_link" reason="Never"/>
  <disable_collisions link1="fr_table_leg_link" link2="rl_caster_wheel_link" reason="Never"/>
  <disable_collisions link1="fr_table_leg_link" link2="rr_caster_wheel_link" reason="Never"/>
  <disable_collisions link1="fr_table_leg_link" link2="volcaniarm_base_link" reason="Never"/>
  <disable_collisions link1="fr_table_leg_link" link2="camera_mount_linear_link" reason="Never"/>
  <disable_collisions link1="fr_table_leg_link" link2="camera_mount_rev_link" reason="Never"/>
  <disable_collisions link1="fr_table_leg_link" link2="camera_link" reason="Never"/>
  <disable_collisions link1="rl_table_leg_link" link2="rr_table_leg_link" reason="Never"/>
  <disable_collisions link1="rl_table_leg_link" link2="fl_caster_wheel_mount_link" reason="Never"/>
  <disable_collisions link1="rl_table_leg_link" link2="fr_caster_wheel_mount_link" reason="Never"/>
  <disable_collisions link1="rl_table_leg_link" link2="rl_caster_wheel_mount_link" reason="Never"/>
  <disable_collisions link1="rl_table_leg_link" link2="rr_caster_wheel_mount_link" reason="Never"/>
  <disable_collisions link1="rl_table_leg_link" link2="fl_caster_wheel_link" reason="Never"/>
  <disable_collisions link1="rl_table_leg_link" link2="fr_caster_wheel_link" reason="Never"/>
  <disable_collisions link1="rl_table_leg_link" link2="rl_caster_wheel_link" reason="Never"/>
  <disable_collisions link1="rl_table_leg_link" link2="rr_caster_wheel_link" reason="Never"/>
  <disable_collisions link1="rl_table_leg_link" link2="volcaniarm_base_link" reason="Never"/>
  <disable_collisions link1="rl_table_leg_link" link2="camera_mount_linear_link" reason="Never"/>
  <disable_collisions link1="rl_table_leg_link" link2="camera_mount_rev_link" reason="Never"/>
  <disable_collisions link1="rl_table_leg_link" link2="camera_link" reason="Never"/>
  <disable_collisions link1="rr_table_leg_link" link2="fl_caster_wheel_mount_link" reason="Never"/>
  <disable_collisions link1="rr_table_leg_link" link2="fr_caster_wheel_mount_link" reason="Never"/>
  <disable_collisions link1="rr_table_leg_link" link2="rl_caster_wheel_mount_link" reason="Never"/>
  <disable_collisions link1="rr_table_leg_link" link2="rr_caster_wheel_mount_link" reason="Never"/>
  <disable_collisions link1="rr_table_leg_link" link2="fl_caster_wheel_link" reason="Never"/>
  <disable_collisions link1="rr_table_leg_link" link2="fr_caster_wheel_link" reason="Never"/>
  <disable_collisions link1="rr_table_leg_link" link2="rl_caster_wheel_link" reason="Never"/>
  <disable_collisions link1="rr_table_leg_link" link2="rr_caster_wheel_link" reason="Never"/>
  <disable_collisions link1="rr_table_leg_link" link2="volcaniarm_base_link" reason="Never"/>
  <disable_collisions link1="rr_table_leg_link" link2="camera_mount_linear_link" reason="Never"/>
  <disable_collisions link1="rr_table_leg_link" link2="camera_mount_rev_link" reason="Never"/>
  <disable_collisions link1="rr_table_leg_link" link2="camera_link" reason="Never"/>
  <disable_collisions link1="fl_caster_wheel_mount_link" link2="fr_caster_wheel_mount_link" reason="Never"/>
  <disable_collisions link1="fl_caster_wheel_mount_link" link2="rl_caster_wheel_mount_link" reason="Never"/>
  <disable_collisions link1="fl_caster_wheel_mount_link" link2="rr_caster_wheel_mount_link" reason="Never"/>
  <disable_collisions link1="fl_caster_wheel_mount_link" link2="fl_caster_wheel_link" reason="Never"/>
  <disable_collisions link1="fl_caster_wheel_mount_link" link2="fr_caster_wheel_link" reason="Never"/>
  <disable_collisions link1="fl_caster_wheel_mount_link" link2="rl_caster_wheel_link" reason="Never"/>
  <disable_collisions link1="fl_caster_wheel_mount_link" link2="rr_caster_wheel_link" reason="Never"/>
  <disable_collisions link1="fl_caster_wheel_mount_link" link2="volcaniarm_base_link" reason="Never"/>
  <disable_collisions link1="fl_caster_wheel_mount_link" link2="camera_mount_linear_link" reason="Never"/>
  <disable_collisions link1="fl_caster_wheel_mount_link" link2="camera_mount_rev_link" reason="Never"/>
  <disable_collisions link1="fl_caster_wheel_mount_link" link2="camera_link" reason="Never"/>
  <disable_collisions link1="fr_caster_wheel_mount_link" link2="rl_caster_wheel_mount_link" reason="Never"/>
  <disable_collisions link1="fr_caster_wheel_mount_link" link2="rr_caster_wheel_mount_link" reason="Never"/>
  <disable_collisions link1="fr_caster_wheel_mount_link" link2="fl_caster_wheel_link" reason="Never"/>
  <disable_collisions link1="fr_caster_wheel_mount_link" link2="fr_caster_wheel_link" reason="Never"/>
  <disable_collisions link1="fr_caster_wheel_mount_link" link2="rl_caster_wheel_link" reason="Never"/>
  <disable_collisions link1="fr_caster_wheel_mount_link" link2="rr_caster_wheel_link" reason="Never"/>
  <disable_collisions link1="fr_caster_wheel_mount_link" link2="volcaniarm_base_link" reason="Never"/>
  <disable_collisions link1="fr_caster_wheel_mount_link" link2="camera_mount_linear_link" reason="Never"/>
  <disable_collisions link1="fr_caster_wheel_mount_link" link2="camera_mount_rev_link" reason="Never"/>
  <disable_collisions link1="fr_caster_wheel_mount_link" link2="camera_link" reason="Never"/>
  <disable_collisions link1="rl_caster_wheel_mount_link" link2="rr_caster_wheel_mount_link" reason="Never"/>
  <disable_collisions link1="rl_caster_wheel_mount_link" link2="fl_caster_wheel_link" reason="Never"/>
  <disable_collisions link1="rl_caster_wheel_mount_link" link2="fr_caster_wheel_link" reason="Never"/>
  <disable_collisions link1="rl_caster_wheel_mount_link" link2="rl_caster_wheel_link" reason="Never"/>
  <disable_collisions link1="rl_caster_wheel_mount_link" link2="rr_caster_wheel_link" reason="Never"/>
  <disable_collisions link1="rl_caster_wheel_mount_link" link2="volcaniarm_base_link" reason="Never"/>
  <disable_collisions link1="rl_caster_wheel_mount_link" link2="camera_mount_linear_link" reason="Never"/>
  <disable_collisions link1="rl_caster_wheel_mount_link" link2="camera_mount_rev_link" reason="Never"/>
  <disable_collisions link1="rl_caster_wheel_mount_link" link2="camera_link" reason="Never"/>
  <disable_collisions link1="rr_caster_wheel_mount_link" link2="fl_caster_wheel_link" reason="Never"/>
  <disable_collisions link1="rr_caster_wheel_mount_link" link2="fr_caster_wheel_link" reason="Never"/>
  <disable_collisions link1="rr_caster_wheel_mount_link" link2="rl_caster_wheel_link" reason="Never"/>
  <disable_collisions link1="rr_caster_wheel_mount_link" link2="rr_caster_wheel_link" reason="Never"/>
  <disable_collisions link1="rr_caster_wheel_mount_link" link2="volcaniarm_base_link" reason="Never"/>
  <disable_collisions link1="rr_caster_wheel_mount_link" link2="camera_mount_linear_link" reason="Never"/>
  <disable_collisions link1="rr_caster_wheel_mount_link" link2="camera_mount_rev_link" reason="Never"/>
  <disable_collisions link1="rr_caster_wheel_mount_link" link2="camera_link" reason="Never"/>
  <disable_collisions link1="fl_caster_wheel_link" link2="fr_caster_wheel_link" reason="Never"/>
  <disable_collisions link1="fl_caster_wheel_link" link2="rl_caster_wheel_link" reason="Never"/>
  <disable_collisions link1="fl_caster_wheel_link" link2="rr_caster_wheel_link" reason="Never"/>
