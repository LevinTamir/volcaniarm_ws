/*

!.gitignore
!/.gitattributes
!/src/
!/volcaniarm_firmware/
!/third_party.repos
!/README.md
!/docs/

# ROS 2 build artifacts
/build/
/install/
/log/

# Editor junk
.vscode/
.idea/
*.swp
*~

# Python cache
__pycache__/
*.pyc

# Colcon
.colcon/

# Claude Code
.claude/

# Third-party packages imported via vcstool (see third_party.repos)
/src/apriltag_ros/
/src/onnxruntime_vendor/
/src/volcaniarm_lerobot/

# Per-physical-setup state written by the calibration dashboard's
# Calibrate camera button. Read by real_bringup at launch to override
# base_link -> camera_link with the calibrated pose. Don't commit.
/src/volcaniarm_calibration/config/camera_pose.yaml
/src/volcaniarm_calibration/config/camera_pose_history.yaml

# experiments/ is its own private repo (volcaniarm-experiments):
# run data, analysis notebooks, and figures live there, versioned
# separately from the code. The /* allowlist above already ignores it.
